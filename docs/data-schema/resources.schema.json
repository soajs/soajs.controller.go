{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resources",
  "x-soajs": {
    "collection": "resources",
    "database": "provision"
  },
  "type": "object",
  "properties": {
    "_id": {
      "type": "object",
      "properties": {
        "$oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        }
      },
      "required": [
        "$oid"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "cluster",
        "server",
        "cdn",
        "system",
        "authorization",
        "other"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "pattern": "^[A-Z0-9]+$"
    },
    "author": {
      "type": "string"
    },
    "locked": {
      "type": "boolean"
    },
    "plugged": {
      "type": "boolean"
    },
    "shared": {
      "type": "boolean"
    },
    "sharedEnvs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z0-9]+$"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "config": {
      "type": "object"
    },
    "settings": {}
  },
  "additionalProperties": false,
  "required": [
    "_id",
    "name",
    "type",
    "category",
    "created",
    "plugged",
    "shared",
    "sharedEnvs",
    "config"
  ],
  "if": {
    "properties": {
      "type": {
        "const": "cluster"
      }
    }
  },
  "then": {
    "properties": {
      "config": {
        "type": "object",
        "properties": {
          "protocol": {
            "enum": [
              "mongodb://",
              "mongodb+srv://"
            ]
          },
          "servers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer"
                }
              },
              "additionalProperties": false,
              "required": [
                "host"
              ]
            }
          },
          "credentials": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1
              },
              "password": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "username",
              "password"
            ]
          },
          "URLParam": {
            "type": "object"
          },
          "streaming": {
            "type": "object"
          },
          "extraParam": {
            "type": "object",
            "maxProperties": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "servers",
          "URLParam"
        ]
      }
    }
  }
}
