{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cache_store",
  "x-soajs": {
    "collection": "cache_store",
    "database": "gateway"
  },
  "type": "object",
  "properties": {
    "_id": {
      "type": "object",
      "properties": {
        "$oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        }
      },
      "required": [
        "$oid"
      ],
      "additionalProperties": false
    },
    "l1": {
      "type": "string",
      "minLength": 1
    },
    "l2": {
      "type": "string",
      "minLength": 1
    },
    "response": {
      "type": "object",
      "properties": {
        "statusCode": {
          "type": "integer"
        },
        "headers": {
          "type": "object"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "statusCode",
        "headers",
        "body"
      ]
    },
    "cachedAt": {
      "type": "object",
      "properties": {
        "$date": {}
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    },
    "expiresAt": {
      "type": "object",
      "properties": {
        "$date": {}
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "api": {
      "type": "string",
      "minLength": 1
    },
    "user": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "_id",
    "l1",
    "l2",
    "response",
    "cachedAt",
    "expiresAt",
    "service",
    "api",
    "user"
  ]
}
