{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "call_events",
  "x-soajs": {
    "collection": "call_events",
    "database": "gateway"
  },
  "type": "object",
  "properties": {
    "_id": {
      "type": "object",
      "properties": {
        "$oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        }
      },
      "required": [
        "$oid"
      ],
      "additionalProperties": false
    },
    "ts": {
      "type": "object",
      "properties": {
        "$date": {}
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "main": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "code"
      ],
      "additionalProperties": false
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "appId": {
      "type": "string",
      "minLength": 1
    },
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "const": true
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "api": {
      "type": "string",
      "pattern": "^/"
    },
    "mcpTool": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "code": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency": {
      "enum": [
        "replay"
      ]
    },
    "cache": {
      "enum": [
        "HIT"
      ]
    },
    "ip": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "_id",
    "ts",
    "durationMs",
    "env",
    "method",
    "status"
  ]
}
